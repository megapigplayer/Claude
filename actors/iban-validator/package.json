{
  "name": "iban-validator",
  "version": "0.1.0",
  "private": true,
  "description": "IBAN Validator & Normalizer: bulk IBAN checksum/format validation, normalization, bank/branch extraction and BIC format check (Apify Actor).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "apify": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ibantools": "4.5.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
