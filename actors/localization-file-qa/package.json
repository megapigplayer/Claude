{
  "name": "localization-file-qa",
  "version": "0.0.1",
  "private": true,
  "description": "Localization File QA and Pseudo-Localizer: lints PO, XLIFF, ARB, .strings, RESX, Android XML and JSON i18n files and generates pseudo-locales incl. RTL (Apify Actor).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "apify": "^3.7.2",
    "gettext-parser": "9.1.1",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
