{
  "name": "graphql-schema-diff",
  "version": "0.0.1",
  "private": true,
  "description": "GraphQL Schema Diff: classifies breaking/dangerous/safe changes between two schemas, Markdown changelog, SARIF and JUnit output for CI (Apify Actor).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@graphql-inspector/core": "8.0.0",
    "apify": "^3.7.2",
    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-xml-parser": "5.11.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
